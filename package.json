{
  "name": "techstack-detector-extension",
  "private": true,
  "version": "1.5.4",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "icons:tech": "node scripts/generate-tech-icons.mjs --verbose",
    "pack:fetch": "node scripts/fetch-wappalyzer.mjs",
    "pack:import": "node scripts/import-wappalyzer.mjs",
    "build:core": "node scripts/build.mjs --no-gpl-pack"
  },
  "dependencies": {
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "simple-icons": "^16.35.0",
    "vite": "^8.3.4"
  }
}
